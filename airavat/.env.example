# Copy to .env (git-ignored) and fill in for Storybook.

# Entra ID app registration (SPA platform, redirect URI http://localhost:6006/)
# with delegated Microsoft Graph Sites.ReadWrite.All and Files.ReadWrite.All.
VITE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# JSON array of handbook sources (one per site). listId = the Site Pages library ID.
VITE_HANDBOOK_SOURCES=[{"webUrl":"https://contoso.sharepoint.com/sites/hr","listId":"00000000-0000-0000-0000-000000000000","siteId":"00000000-0000-0000-0000-000000000000","siteTitle":"HR","parentField":"hbParent","parentId":0}]
